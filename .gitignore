# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE / local tool settings
.idea/
.vscode/
.claude/

# C build (eml_try_1) — regenerated through CMake
build/
.cache/
*.dll
*.exe
*.a

# Training outputs — heavy and reproducible
logs/
runs/
*.pt
!flappy_bird_with_ai/models/best_ga.pt
*.npz

# ── Run outputs ──────────────────────────────────────────────────────────────
# The rule: the repository keeps the FINAL artifacts (the canonical formula of
# each task, the exported C, the raw experiment log). Everything a run
# regenerates or stamps with a date does not belong here — it piles up, it
# dirties `git status` after every experiment, and none of it is a source.

# Timestamped run outputs: a new pair appears on every benchmark.
flappy_bird_with_ai/results/benchmark_*.json
flappy_bird_with_ai/results/benchmark_*.png
flappy_bird_with_ai/results/benchmark_plot.png
# Per-run formulas and oracle metadata; the canonical ones are best_*.
flappy_bird_with_ai/models/eml-*_*.json
flappy_bird_with_ai/models/ga_*.meta.json

# Plots and histories rewritten by every distillation / training run.
tetris/results/*.png
tetris/results/*_history.json
tetris/results/benchmark_*.csv
aerial_classifier/results/*.png
aerial_classifier/results/overlay_*.png

# Raw experiment log: one row per episode, one point per node budget K. Every
# figure is a groupby over these, so they are regenerated rather than authored —
# and they grow on every run, debug ones included. The per-run copies live in
# runs/<date>/, which is also ignored: back these up by hand before they matter.
tetris/results/raw_episodes.csv
tetris/results/pareto_curve.csv

# The aerial model library. The batches already committed stay in the repository
# as results — an ignore rule does not touch files git already tracks. This only
# stops NEW runs from adding themselves.
aerial_classifier/models/library/

# Canonical formulas. Every distillation rewrites them, so keeping them under
# version control meant a dirty tree after every experiment and a diff of a
# 40-node AST that nobody reads. They are outputs, not sources: the repository
# holds the code that produces them.
#
# The consequence is deliberate but worth remembering: together with runs/ and
# the raw logs above, NOTHING experimental is backed up by git any more. A
# formula worth citing in the thesis has to be copied out by hand.
*/models/best_eml*.json

# Generated from the formulas above, and only as current as the last export.
tetris/results/eml_formula.h
aerial_classifier/results/c_export/

# Datasets (tens to hundreds of MB of images) — see aerial_classifier/README.md.
# With a wildcard, because the class folder is now selected by the user, and
# copies and subsets appear next to it: `dataset - copy`, `dataset_2class`.
aerial_classifier/dataset*/

# Model backup taken before the feature scale fix: the old formulas were
# computed in a DIFFERENT feature space and are only a historical snapshot, not
# something for the repository.
aerial_classifier/models_pre_scalefix/

# Cache of decoded datasets (tied to a folder on a specific machine)
aerial_classifier/cache/

# The selected dataset and safety copies of the active models are machine-local:
# dataset.json holds this machine's path, .prev.json the previous version of the
# active model in case of a rollback.
aerial_classifier/models/dataset.json
*.prev.json

# pytest cache
.pytest_cache/

# Internal planning notes — not for publication
PROJECT_BLUEPRINT.md

# Archives and backups
*.zip

# distill_compare: downloaded benchmark CSVs (re-fetched and SHA-pinned by
# datasets.py). Teacher checkpoints are *.pt and already ignored above; the
# result CSVs and REPORT.md are tracked.
distill_compare/data/
